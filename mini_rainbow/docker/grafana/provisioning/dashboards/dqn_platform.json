{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Episode Score (per episode)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "dqn_current_score{agent=\"DQN\"}",
          "legendFormat": "DQN"
        },
        {
          "expr": "dqn_current_score{agent=\"Rainbow-Lite\"}",
          "legendFormat": "Rainbow-Lite"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 10, "pointSize": 5, "showPoints": "always" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "DQN" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#58a6ff" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Rainbow-Lite" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3fb950" } }]
          }
        ]
      }
    },
    {
      "title": "Best Score",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "dqn_best_score{agent=\"DQN\"}",
          "legendFormat": "DQN Best"
        },
        {
          "expr": "dqn_best_score{agent=\"Rainbow-Lite\"}",
          "legendFormat": "Rainbow-Lite Best"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 5 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "DQN Best" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#58a6ff" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Rainbow-Lite Best" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3fb950" } }]
          }
        ]
      }
    },
    {
      "title": "Episodes Completed",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "dqn_episodes_total{agent=\"DQN\"}",
          "legendFormat": "DQN"
        },
        {
          "expr": "dqn_episodes_total{agent=\"Rainbow-Lite\"}",
          "legendFormat": "Rainbow-Lite"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#4fc3f7" }
        },
        "overrides": []
      }
    },
    {
      "title": "Total Steps",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 8 },
      "targets": [
        {
          "expr": "dqn_steps_total{agent=\"DQN\"}",
          "legendFormat": "DQN"
        },
        {
          "expr": "dqn_steps_total{agent=\"Rainbow-Lite\"}",
          "legendFormat": "Rainbow-Lite"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#81c784" }
        },
        "overrides": []
      }
    },
    {
      "title": "Actions / Second",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "dqn_actions_per_second",
          "legendFormat": "{{agent}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 60,
          "thresholds": {
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 15 },
              { "color": "green", "value": 25 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Cumulative Reward",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 8 },
      "targets": [
        {
          "expr": "dqn_total_reward{agent=\"DQN\"}",
          "legendFormat": "DQN"
        },
        {
          "expr": "dqn_total_reward{agent=\"Rainbow-Lite\"}",
          "legendFormat": "Rainbow-Lite"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#ffb74d" }
        },
        "overrides": []
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["dqn", "reinforcement-learning"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Mini-Rainbow DQN",
  "uid": "mini-rainbow-dqn",
  "version": 1
}
