FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml README.md ./
COPY mini_rainbow/ ./mini_rainbow/

# Install PyTorch CPU (smallest footprint for inference demo)
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

# Install core + API deps + Pillow for frame rendering
RUN pip install --no-cache-dir -e ".[api]" Pillow

# Copy checkpoint (must be provided at build time or mounted at runtime)
# Default: expects checkpoint at /app/checkpoint_best.pt
ENV CHECKPOINT_PATH=/app/checkpoint_best.pt
ENV DUELING=false
ENV DEVICE=cpu

EXPOSE 8000

ENTRYPOINT ["python", "-m", "mini_rainbow.scripts.demo"]
CMD ["--checkpoint", "/app/checkpoint_best.pt"]
